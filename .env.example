# Twilio credentials (get from https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1234567890

# Twilio webhook callback (leave blank for local dev, set on deploy)
TWILIO_STATUS_CALLBACK_URL=

# Frontend origin (for CORS)
FRONTEND_ORIGIN=http://localhost:4200

# JWT secret key (generate with: rails secret)
DEVISE_JWT_SECRET_KEY=your-secret-key-change-in-production
